# Web uses the Kivelli gateway. Native builds must use the direct project URL.
EXPO_PUBLIC_SUPABASE_WEB_URL=https://kivelli.app/supabase
EXPO_PUBLIC_SUPABASE_NATIVE_URL=https://mfysnlghlhxxcwnwpxog.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-the-public-publishable-key
EXPO_PUBLIC_TOGETHER_EAS_PROJECT_ID=ffa20139-6b44-425f-9370-ea451e1061ba
# Enable only after the corresponding provider is configured in Supabase Auth.
EXPO_PUBLIC_KIVELLE_GOOGLE_AUTH_ENABLED=true
EXPO_PUBLIC_KIVELLE_APPLE_AUTH_ENABLED=false
EXPO_PUBLIC_KIVELLE_PERFORMANCE_REPORTING_ENABLED=true

# Native Apple/Google subscriptions. These are RevenueCat public SDK keys,
# never secret API keys. Real purchases require an iOS/Android development or
# store build; Expo Go can only preview the flow.
EXPO_PUBLIC_KIVELLE_REVENUECAT_ENABLED=false
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
# Optional. When omitted, the RevenueCat current offering is used.
EXPO_PUBLIC_KIVELLE_REVENUECAT_OFFERING_ID=default

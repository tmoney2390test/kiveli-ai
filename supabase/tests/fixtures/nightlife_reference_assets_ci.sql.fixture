-- CI-only metadata for portrait bytes imported out of band in production.
with nightlife_slugs(slug) as(values
  ('lila-quinn'),('sienna-cruz'),('giada-morelli'),('paloma-vargas')
)
insert into public.together_media_reference_assets(
  asset_role,character_version_id,source_key,storage_bucket,storage_path,
  content_type,revision,active,metadata
)
select
  'character_identity',version.id,'character:'||template.slug||':identity',
  'kivelle-character-reference','ci/nightlife/'||template.slug||'/identity.png',
  'image/png',1,true,'{"ciFixture":true}'::jsonb
from nightlife_slugs expected
join public.together_character_templates template on template.slug=expected.slug
join public.together_character_versions version
  on version.character_template_id=template.id
 and version.version=template.current_published_version
on conflict(asset_role,source_key,revision) do nothing;

-- This fixture sorts immediately before the migration that creates these four
-- characters. Seed their out-of-band portrait metadata as soon as that
-- migration writes each world-presence row.
create or replace function public.kivelle_ci_seed_nightlife_character_asset()
returns trigger
language plpgsql
set search_path=public
as $$
declare
  v_slug text;
begin
  select template.slug into v_slug
  from public.together_character_versions version
  join public.together_character_templates template
    on template.id=version.character_template_id
  where version.id=new.character_version_id;

  if v_slug in('lila-quinn','sienna-cruz','giada-morelli','paloma-vargas') then
    insert into public.together_media_reference_assets(
      asset_role,character_version_id,source_key,storage_bucket,storage_path,
      content_type,revision,active,metadata
    ) values(
      'character_identity',new.character_version_id,
      'character:'||v_slug||':identity',
      'kivelle-character-reference','ci/nightlife/'||v_slug||'/identity.png',
      'image/png',1,true,'{"ciFixture":true}'::jsonb
    )
    on conflict(asset_role,source_key,revision) do nothing;
  end if;
  return new;
end;
$$;

drop trigger if exists kivelle_ci_seed_nightlife_character_asset
  on public.together_character_world_presence;
create trigger kivelle_ci_seed_nightlife_character_asset
after insert or update of character_version_id,world_id
on public.together_character_world_presence
for each row execute function public.kivelle_ci_seed_nightlife_character_asset();

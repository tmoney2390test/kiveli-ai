{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kivelli-voice-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "routes": [
    { "pattern": "voice.kivelli.app", "custom_domain": true }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "VOICE_CALL_GUARD", "class_name": "VoiceCallGuard" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["VoiceCallGuard"] }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "XAI_STT_URL": "wss://api.x.ai/v1/stt",
    "XAI_TTS_URL": "wss://api.x.ai/v1/tts",
    "XAI_RESPONSES_URL": "https://api.x.ai/v1/responses"
  }
}

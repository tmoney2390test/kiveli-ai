{
  "name": "kivelli-app-gateway",
  "main": "index.js",
  "compatibility_date": "2026-08-24",
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "../../../apps/together/dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "kivelli.app",
      "custom_domain": true
    },
    {
      "pattern": "www.kivelli.app",
      "custom_domain": true
    }
  ]
}

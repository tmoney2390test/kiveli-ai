# Server-side Supabase Edge Function secrets only. Never expose these through EXPO_PUBLIC_*.
# Dialogue inference. OpenAI Luna handles all production dialogue, which is
# capped at non-sexual romance. The legacy xAI chat flags remain off; XAI_API_KEY
# may still be configured independently for non-sexual voice features.
OPENAI_API_KEY=
KIVELLE_OPENAI_DIALOGUE_MODEL=gpt-5.6-luna
# Subscriber photo sharing reuses the same server key for image moderation and understanding.
KIVELLE_VISION_PROVIDER=openai
KIVELLE_OPENAI_VISION_ENABLED=true
KIVELLE_OPENAI_VISION_MODEL=gpt-5.6-luna
# Legacy compatibility fallbacks remain supported:
KIVELLE_DIALOGUE_MODEL=
TOGETHER_DIALOGUE_MODEL=
XAI_API_KEY=
KIVELLE_XAI_ENABLED=false
KIVELLE_XAI_DIALOGUE_MODEL=grok-4.3
KIVELLE_XAI_EXPLICIT_ENABLED=false
KIVELLE_AI_COST_TELEMETRY_ENABLED=true
# Short database-backed provider semaphores; tune to account/provider quotas.
KIVELLE_OPENAI_MAX_CONCURRENCY=64
KIVELLE_XAI_MAX_CONCURRENCY=32
# Optional; set only to an effort supported by KIVELLE_DIRECTOR_MODEL.
KIVELLE_DIRECTOR_REASONING_EFFORT=
KIVELLE_CONVERSATIONAL_HANDOFFS_ENABLED=true
# Uses the inexpensive Director only when deterministic group speaker scores are close.
KIVELLE_GROUP_DIRECTOR_ENABLED=true

# Optional companion-initiative voice pass. It uses isolated character context
# and falls back to deterministic grounded copy on timeout/provider failure.
KIVELLE_PROACTIVE_VOICE_ENABLED=true
KIVELLE_PROACTIVE_MODEL=gpt-5.6-luna

# Chat dictation / voice-to-text (Supabase Edge Function secrets only).
KIVELLE_STT_PROVIDER=openai
KIVELLE_OPENAI_TRANSCRIPTION_ENABLED=false
KIVELLE_OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# xAI voice (Supabase Edge Function secrets only). xAI's batch TTS endpoint
# currently has no selectable request model; KIVELLE_XAI_TTS_MODEL is an
# internal telemetry label and is not sent to /v1/tts.
KIVELLE_TTS_PROVIDER=xai
KIVELLE_REALTIME_VOICE_PROVIDER=xai
KIVELLE_XAI_TTS_ENABLED=false
KIVELLE_XAI_REALTIME_VOICE_ENABLED=false
KIVELLE_XAI_TTS_MODEL=xai-text-to-speech
KIVELLE_XAI_REALTIME_VOICE_MODEL=grok-voice-think-fast-2.0
KIVELLE_XAI_VOICE_CANARY_PERCENT=0
KIVELLE_XAI_VOICE_COST_TELEMETRY_ENABLED=true

# Layered live calls. Essential uses the Cloudflare relay and spends the same
# general Kivelle Credit balance as Immersive, at a lower per-minute rate.
# Keep Essential disabled until the relay benchmark passes.
KIVELLE_XAI_CASCADED_VOICE_ENABLED=false
KIVELLE_XAI_CASCADED_VOICE_CANARY_PERCENT=0
KIVELLE_VOICE_RELAY_URL=wss://voice.kivelli.app/v1/call
KIVELLE_VOICE_RELAY_SIGNING_SECRET=
KIVELLE_XAI_STREAMING_STT_MODEL=grok-transcribe
KIVELLE_XAI_CASCADE_DIALOGUE_MODEL=grok-4.3
KIVELLE_XAI_STREAMING_TTS_MODEL=xai-text-to-speech
KIVELLE_STANDARD_VOICE_CREDITS_PER_MINUTE=3
KIVELLE_EXPRESS_VOICE_CREDITS_PER_MINUTE=8

WAVESPEED_API_KEY=
WAVESPEED_WEBHOOK_SECRET=
# Shared by request-time dispatch kicks and the Supabase Cron recovery sweep.
TOGETHER_MEDIA_DISPATCH_SECRET=
# Global queued/generating image and video backpressure ceiling.
KIVELLE_MEDIA_MAX_INFLIGHT=48
KIVELLE_WAVESPEED_ENABLED=false
KIVELLE_WAVESPEED_CANARY_PERCENT=0
KIVELLE_WAVESPEED_CREATOR_ENABLED=false
KIVELLE_VIDEO_ENABLED=false
# Server-authoritative video selector. Keep `off` until the WaveSpeed routes,
# price ceilings, webhook, and tester allowlist are configured in Supabase.
KIVELLE_VIDEO_MODEL_SELECTOR_MODE=off
KIVELLE_VIDEO_TESTER_USER_IDS=
KIVELLE_VIDEO_DEFAULT_ROUTE_ID=wavespeed-p-video-i2v
KIVELLE_VIDEO_MAX_INFLIGHT=4
KIVELLE_IMAGE_MAX_INFLIGHT=48
KIVELLE_VIDEO_ROUTE_GEMINI_OMNI_FLASH_I2V_ENABLED=false
KIVELLE_VIDEO_ROUTE_GEMINI_OMNI_FLASH_I2V_MAX_USD=0.90
KIVELLE_VIDEO_ROUTE_GEMINI_OMNI_FLASH_I2V_CONCURRENCY=3
KIVELLE_VIDEO_ROUTE_MINIMAX_H3_I2V_ENABLED=false
KIVELLE_VIDEO_ROUTE_MINIMAX_H3_I2V_MAX_USD=0.70
KIVELLE_VIDEO_ROUTE_MINIMAX_H3_I2V_CONCURRENCY=1
KIVELLE_VIDEO_ROUTE_P_VIDEO_I2V_ENABLED=false
KIVELLE_VIDEO_ROUTE_P_VIDEO_I2V_MAX_USD=0.20
KIVELLE_VIDEO_ROUTE_P_VIDEO_I2V_CONCURRENCY=3
KIVELLE_VIDEO_ROUTE_GEMINI_OMNI_FLASH_R2V_ENABLED=false
KIVELLE_VIDEO_ROUTE_GEMINI_OMNI_FLASH_R2V_MAX_USD=1.00
KIVELLE_VIDEO_ROUTE_GEMINI_OMNI_FLASH_R2V_CONCURRENCY=2
KIVELLE_VIDEO_ROUTE_MINIMAX_H3_R2V_ENABLED=false
KIVELLE_VIDEO_ROUTE_MINIMAX_H3_R2V_MAX_USD=2.00
KIVELLE_VIDEO_ROUTE_MINIMAX_H3_R2V_CONCURRENCY=1
KIVELLE_WAVESPEED_LORA_ENABLED=false
KIVELLE_WAVESPEED_EXPERIMENTAL_ROUTES=false
KIVELLE_WAVESPEED_ADULT_ROUTE_VALIDATED=false
KIVELLE_WAVESPEED_ADULT_VIDEO_ROUTE_VALIDATED=false
KIVELLE_WAVESPEED_VIDEO_LORA_VALIDATED=false
KIVELLE_ADULT_MEDIA_ENABLED=false
# World containment is server-owned and always applied. When quality checking
# is connected, fail closed if the generated environment cannot be verified.
KIVELLE_MEDIA_QUALITY_GATE_ENABLED=true
KIVELLE_MEDIA_WORLD_QA_REQUIRED=true

# Venice still-image provider. KIVELLE_IMAGE_PROVIDER=venice makes Venice the
# preferred still-image route while WaveSpeed remains available for video,
# Creator identity training, and configured fallbacks. The adult route stays
# fail-closed until its provider/account terms and models have been validated.
VENICE_API_KEY=
KIVELLE_IMAGE_PROVIDER=venice
KIVELLE_VENICE_ENABLED=false
KIVELLE_VENICE_API_BASE=https://api.venice.ai/api/v1
KIVELLE_VENICE_STANDARD_MODEL=qwen-image-2-edit
KIVELLE_VENICE_STANDARD_FALLBACK_MODEL=firered-image-edit
KIVELLE_VENICE_QUALITY_MODEL=qwen-image-2-pro-edit
KIVELLE_VENICE_ADULT_MODEL=grok-imagine-edit
# Approved adult final edit. Kivelle still enforces verified-adult, fictional-
# character, consent, and content gates before this private Venice model runs.
KIVELLE_VENICE_ADULT_FINAL_MODEL=qwen-edit
KIVELLE_VENICE_ADULT_FALLBACK_MODEL=firered-image-edit
KIVELLE_VENICE_VISION_MODEL=qwen3-vl-235b-a22b
KIVELLE_VENICE_ADULT_ROUTE_VALIDATED=false

# Stripe server secrets. Create products/prices in Stripe, then configure these
# only in Supabase Edge Function secrets. Never expose sk_* or whsec_* values
# through EXPO_PUBLIC_*.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Internal daily grant worker authorization. Store the same value in Supabase
# Vault as kivelle_billing_grant_secret before enabling the cron schedule.
KIVELLE_BILLING_GRANT_SECRET=
STRIPE_AUTOMATIC_TAX_ENABLED=false
STRIPE_PRICE_KIVELLE_PLUS_MONTHLY=
STRIPE_PRICE_KIVELLE_MAX_MONTHLY=
# Optional annual recurring prices ($199.99 Plus / $399.99 Max catalog targets).
STRIPE_PRICE_KIVELLE_PLUS_ANNUAL=
STRIPE_PRICE_KIVELLE_MAX_ANNUAL=
STRIPE_PRICE_CREDITS_100=
STRIPE_PRICE_CREDITS_300=
STRIPE_PRICE_CREDITS_800=
STRIPE_PRICE_CREDITS_2000=
# Legacy single-pack fallback. Prefer the four server-authoritative pack prices above.
STRIPE_PRICE_KIVELLE_CREDITS=
STRIPE_CREDITS_AMOUNT=
KIVELLE_PUBLIC_APP_URL=https://kivelli.app
# Optional HTTPS overrides:
KIVELLE_CHECKOUT_SUCCESS_URL=
KIVELLE_CHECKOUT_CANCEL_URL=
KIVELLE_BILLING_RETURN_URL=
# Optional web-only publishable key for future embedded Stripe Elements. Hosted
# Checkout does not require it; publishable pk_* values are never server secrets.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Validated WaveSpeed model routes. Change only after benchmark approval.
WAVESPEED_MODEL_GROUP_MULTIREF=wavespeed-ai/qwen-image-2.0-pro/edit
WAVESPEED_MODEL_MULTIREF=wavespeed-ai/flux-kontext-dev/multi-ultra-fast
WAVESPEED_MODEL_STANDARD_LORA=wavespeed-ai/z-image/turbo-lora
WAVESPEED_MODEL_STANDARD_I2I_LORA=wavespeed-ai/z-image-turbo/image-to-image-lora
WAVESPEED_MODEL_MULTIREF_LORA=wavespeed-ai/flux-2-klein-4b/edit-lora
WAVESPEED_MODEL_VIDEO=wavespeed-ai/ltx-2.3-spicy/image-to-video
WAVESPEED_MODEL_VIDEO_LORA=wavespeed-ai/ltx-2.3-spicy/image-to-video-lora
WAVESPEED_MODEL_EXPLICIT=wavespeed-ai/chroma
WAVESPEED_MODEL_ZIMAGE_TRAINER=wavespeed-ai/z-image/base-lora-trainer
# Group photos are capped at two fictional adult companions. The general flag
# enables standard/romance group edits; adult levels also require the separately
# validated flag and the existing global adult-media policy gates.
KIVELLE_WAVESPEED_GROUP_IMAGES_ENABLED=false
KIVELLE_WAVESPEED_GROUP_ADULT_ROUTE_VALIDATED=false

# Production operations. Keep admin IDs server-only. Internal accounts may
# alternatively use app_metadata.together_admin=true or together_internal=true.
TOGETHER_ADMIN_USER_IDS=
TOGETHER_DEBUG_USER_IDS=
# Optional external alert channels. Dashboard incidents work without these.
KIVELLE_OPS_ALERT_WEBHOOK_URL=
RESEND_API_KEY=
KIVELLE_OPS_ALERT_EMAIL=
KIVELLE_OPS_ALERT_FROM=
# Release identifiers shown in /ops when supplied by the deployment pipeline.
KIVELLE_RELEASE_COMMIT=
KIVELLE_WEB_DEPLOYMENT_ID=

# Kivelli Stories. The engine remains deterministic; this optional model only
# expresses already-authorized character dialogue. Set an entitlement key to
# stage access, or leave it empty for every authenticated Kivelli account.
KIVELLE_STORIES_ENABLED=true
KIVELLE_STORIES_ACCESS_ENTITLEMENT=
KIVELLE_STORY_DIALOGUE_MODEL=gpt-5.6-luna
KIVELLE_STORY_INSPECTOR_ENABLED=false
# Client reporting contains sanitized diagnostics only—never prompts/messages.
EXPO_PUBLIC_KIVELLE_ERROR_REPORTING_ENABLED=true
EXPO_PUBLIC_KIVELLE_PERFORMANCE_REPORTING_ENABLED=true

{
  "name": "together-ai",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "web": "pnpm --filter @together/app web",
    "web:build": "pnpm --filter @together/app web:build",

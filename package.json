    "supabase:test": "supabase test db"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "supabase": "^2.111.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0"
  }
}

{
  "name": "together-ai",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "web": "pnpm --filter @together/app web",
    "web:build": "pnpm --filter @together/app web:build",
    "web:budget": "node scripts/check-web-performance-budget.mjs",
    "audit:navigation": "node scripts/audit-navigation-controls.mjs",
    "audit:production-routes": "node scripts/audit-production-routes.mjs",
    "typecheck": "pnpm --filter @together/app typecheck && pnpm --filter @together/domain typecheck",
    "test": "pnpm --filter @together/app test && pnpm --filter @together/domain test && pnpm gateway:test && pnpm audit:production-routes:test",
    "gateway:test": "node --test infra/cloudflare/kivelli-app-gateway/index.test.mjs",
    "audit:production-routes:test": "node --test scripts/audit-production-routes.test.mjs",
    "lint": "eslint .",
    "guard:starter-content": "node scripts/check-starter-content.mjs",
    "edge:typecheck": "node scripts/check-edge-functions.mjs",
    "supabase:test": "supabase test db",
    "life:simulate": "node --experimental-strip-types scripts/simulate-life-engine.ts",
    "media:sync-references": "node --experimental-strip-types scripts/sync-kivelle-reference-media.ts",
    "media:audit-character-references": "node --experimental-strip-types scripts/audit-kivelle-character-references.ts",
    "voice:audit-production": "node --experimental-strip-types scripts/audit-kivelle-voice-production.ts",
    "voice:smoke-production": "node --experimental-strip-types scripts/smoke-kivelle-voice-production.ts",
    "eos:audit-production": "node --experimental-strip-types scripts/audit-eos-meridian-production.ts",
    "media:prepare-lora": "node --experimental-strip-types scripts/prepare-kivelle-character-lora.ts",
    "media:create-benchmark": "node --experimental-strip-types scripts/create-kivelle-media-benchmark.ts",
    "media:normalize-video-faststart": "node --experimental-strip-types scripts/normalize-kivelli-video-faststart.ts",
    "stories:validate": "node --experimental-strip-types scripts/validate-kivelli-stories.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@supabase/supabase-js": "2.93.3",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "fflate": "0.8.2",
    "globals": "^16.5.0",
    "supabase": "^2.111.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "wrangler": "^4.127.1"
  },
  "workspaces": ["apps/*", "packages/*"]
}
